MEMORY {
    code     : ORIGIN = 0x00000000, LENGTH = 0x00004000
    data     : ORIGIN = 0x00004000, LENGTH = 0x00000800
    spiflash : ORIGIN = 0x10000000, LENGTH = 0x01000000
    psram : ORIGIN = 0x20000000, LENGTH = 0x01000000
}

_stext = ORIGIN(code);
_hart_stack_size = 1792;

REGION_ALIAS("REGION_TEXT", code);
REGION_ALIAS("REGION_RODATA", code);
REGION_ALIAS("REGION_DATA", data);
REGION_ALIAS("REGION_BSS", data);
REGION_ALIAS("REGION_HEAP", data);
REGION_ALIAS("REGION_STACK", data);
